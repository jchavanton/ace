# Build output
/ace
*.test

# Per-run output (results.json + captured WAVs)
/runs/*
!/runs/.keep

# Runtime bot state (alert_config.json, per-bot JSON) — written by the
# controller, not source.
/bots/

# Local bridge binary / stray artifact at repo root.
/bridge

# Local-only overrides
/config.local.yml

# Operator-local ansible inventory. Each deployer maintains their own
# host list; the committed inventory.example.yml is the schema and
# shared baseline — copy to inventory.yml after cloning and edit.
/ansible/inventory.yml
