# Rendered by ansible — do not hand-edit; changes will be overwritten
# on the next playbook run. Inventory vars in ansible/inventory.yml
# control the values here.

ACE_ADDR={{ ace_http_addr_effective }}
ACE_VOIP_PATROL_PORT={{ ace_sip_port }}
ACE_RTP_PORT_START={{ ace_rtp_port_start }}
ACE_RTP_PORT_END={{ ace_rtp_port_end }}
ACE_PUBLIC_ADDRESS={{ ace_public_address_effective | default('') }}
# Comma-separated private IPs surfaced in ACE's UI Network dropdown.
# Overrides in-container interface enumeration — needed on GCP where
# the container's veth (172.x) isn't what an operator wants to advertise.
ACE_LOCAL_IPS={{ ace_local_ips_effective | default('') }}
{% if ace_auth_enabled | default(false) %}
ACE_BASIC_AUTH_HTPASSWD=/data/auth/htpasswd
{% endif %}
